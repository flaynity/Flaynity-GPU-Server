PORT=3001
NODE_ENV=development

# R2 / Cloudflare
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET_NAME=flaynity-media
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_PUBLIC_BASE_URL=https://cdn.flaynity.indevs.in

# Job storage
WORK_DIR=/tmp/flaynity-gpu

# Optional server callback or orchestration
FLAYNITY_SERVER_URL=http://localhost:3000

# FFmpeg tuning
FFMPEG_PRESET=medium
FFMPEG_CRF=28
GPU_ENABLED=false
