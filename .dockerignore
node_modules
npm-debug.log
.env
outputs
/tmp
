const express = require('express');
const fs = require('fs');
const path = require('path');
const { v4: uuidv4 } = require('uuid');
const config = require('./config');
const { createJob, getJob, getAllJobs, processJob, ensureWorkspace } = require('./jobQueue');
const { uploadDirectoryToR2 } = require('./r2');

const app = express();
const PORT = config.port;

app.use(express.json({ limit: '500mb' }));

app.get('/health', (req, res) => {
  res.json({ ok: true, service: 'Flaynity GPU Server', status: 'healthy', port: PORT });
});

app.get('/api/jobs', (req, res) => {
  res.json({ jobs: getAllJobs() });
});

app.get('/api/jobs/:id', (req, res) => {
  const job = getJob(req.params.id);
  if (!job) {
    return res.status(404).json({ error: 'Job not found' });
  }

  return res.json(job);
});

app.post('/api/jobs/create', async (req, res) => {
  try {
    const { sourceUrl, jobId, videoProvider, meta, inputFilePath } = req.body || {};

    if (!sourceUrl && !inputFilePath) {
      return res.status(400).json({ error: 'sourceUrl or inputFilePath is required' });
    }

    const job = createJob({
      sourceUrl,
      jobId: jobId || uuidv4(),
      videoProvider: videoProvider || 'r2-hls',
      inputFilePath,
      meta: meta || {},
    });

    if (sourceUrl) {
      job.inputFilePath = path.join(config.workDir, job.id, 'source.mp4');
      ensureWorkspace();
      fs.mkdirSync(path.dirname(job.inputFilePath), { recursive: true });

      const response = await fetch(sourceUrl);
      if (!response.ok) {
        throw new Error(`Failed to download source file: ${response.status}`);
      }

      const buffer = Buffer.from(await response.arrayBuffer());
      fs.writeFileSync(job.inputFilePath, buffer);
    }

    processJob(job.id)
      .then(async (completedJob) => {
        const uploadResult = await uploadDirectoryToR2(completedJob.outputDir, `media/uploads/hls/${completedJob.id}`);
        completedJob.uploadedFiles = uploadResult;
        completedJob.videoLink = `${config.r2.publicBaseUrl}/media/uploads/hls/${completedJob.id}/master.m3u8`;
        completedJob.videoUrl = `${completedJob.id}/master.m3u8`;
        completedJob.hlsUrl = `${completedJob.id}/master.m3u8`;

        if (completedJob.meta && completedJob.meta.callbackUrl) {
          try {
            await fetch(completedJob.meta.callbackUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                event: 'video.transcoded',
                job: completedJob,
              }),
            });
          } catch (callbackError) {
            console.warn('Callback failed:', callbackError.message);
          }
        }
      })
      .catch((error) => {
        console.error('Job processing error:', error);
      });

    return res.status(202).json(job);
  } catch (error) {
    console.error('create job error', error);
    return res.status(500).json({ error: error.message || 'Failed to create job' });
  }
});

app.listen(PORT, () => {
  console.log(`Flaynity GPU Server listening on http://localhost:${PORT}`);
});
